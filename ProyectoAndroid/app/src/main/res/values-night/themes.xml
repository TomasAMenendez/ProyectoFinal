<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night). -->
    <style name="Theme.AplicacionParaCelular" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/on_background_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <style name="TextAppearance.Teo.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teo_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teo_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/teo_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/teo_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Metric" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teo_on_cyan</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Name" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teo_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/teo_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Teo.Chip" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Teo.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/teo_surface</item>
        <item name="cardCornerRadius">@dimen/teo_card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">@dimen/teo_card_padding</item>
    </style>

    <style name="Widget.Teo.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/teo_button_min_height</item>
        <item name="backgroundTint">@color/teo_primary</item>
        <item name="cornerRadius">@dimen/teo_button_radius</item>
    </style>

    <style name="Widget.Teo.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/teo_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/teo_button_min_height</item>
        <item name="strokeColor">@color/teo_primary</item>
        <item name="cornerRadius">@dimen/teo_button_radius</item>
    </style>

    <style name="Widget.Teo.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/teo_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/teo_button_min_height</item>
    </style>
</resources>