<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teo_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/teo_screen_margin"
        android:paddingEnd="@dimen/teo_screen_margin"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/my_teo_back"
                android:src="@drawable/teo_ic_back"
                app:tint="@color/teo_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/my_teo_settings"
                android:textAppearance="@style/TextAppearance.Teo.Home.Title" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Teo.Home.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_intro"
            android:textAppearance="@style/TextAppearance.Teo.Home.Body" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_volume"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                    <TextView
                        android:id="@+id/txt_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_unknown"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:stepSize="5"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/teo_primary"
                    app:thumbColor="@color/teo_primary"
                    app:trackColorActive="@color/teo_primary"
                    app:trackColorInactive="@color/teo_outline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_brightness"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                    <TextView
                        android:id="@+id/txt_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_unknown"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:stepSize="5"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/teo_primary"
                    app:thumbColor="@color/teo_primary"
                    app:trackColorActive="@color/teo_primary"
                    app:trackColorInactive="@color/teo_outline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_apply_help"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply"
                    style="@style/Widget.Teo.Home.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/settings_apply" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_night"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_night"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_night_help"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_night_music"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_loading"
            android:textAppearance="@style/TextAppearance.Teo.Home.Secondary" />
    </LinearLayout>
</ScrollView>
