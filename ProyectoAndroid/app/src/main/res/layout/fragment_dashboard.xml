<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teo_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/teo_screen_margin"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/teo_screen_margin"
        android:paddingBottom="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/header_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/header_actions"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/home_logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/teo_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/home_title"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/header_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/btn_alerts_bell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="@dimen/teo_icon_size"
                        android:layout_height="@dimen/teo_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/teo_ic_bell"
                        app:tint="@color/teo_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_alerts"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Chip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_my_teo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="@dimen/teo_icon_size"
                        android:layout_height="@dimen/teo_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/teo_ic_gear"
                        app:tint="@color/teo_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_my_teo"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Chip" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/teo_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_character"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/home_character"
                    android:minHeight="112dp"
                    android:scaleType="matrix"
                    android:src="@drawable/teo_character_wave" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEO"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Name" />

                    <LinearLayout
                        android:id="@+id/status_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_connection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/teo_neutral"
                            android:drawablePadding="4dp"
                            android:gravity="center"
                            android:minHeight="28dp"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Chip"
                            tools:text="Conectado" />

                        <TextView
                            android:id="@+id/txt_activity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/teo_neutral"
                            android:drawablePadding="4dp"
                            android:gravity="center"
                            android:minHeight="28dp"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Chip"
                            tools:text="Despierto" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_power"
                        style="@style/Widget.Teo.Home.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_stop"
                        android:textColor="@color/teo_button_text"
                        app:backgroundTint="@color/teo_button_bg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_connection"
                        style="@style/Widget.Teo.Home.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_see_connection"
                        app:icon="@drawable/teo_ic_chevron"
                        app:iconGravity="textEnd"
                        app:iconPadding="2dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/teo_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/teo_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_today"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/interactions_bubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:importantForAccessibility="yes"
                        android:minWidth="88dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/teo_speech_body"
                            android:gravity="center"
                            android:minWidth="88dp"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/txt_interactions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/home_absent"
                                android:textAppearance="@style/TextAppearance.Teo.Home.Metric" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/home_interactions_word"
                                android:textAppearance="@style/TextAppearance.Teo.Home.Chip"
                                android:textColor="@color/teo_on_cyan" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center_horizontal"
                            android:importantForAccessibility="no"
                            android:src="@drawable/teo_speech_tail" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_signal_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_last_signal"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Body" />

                        <TextView
                            android:id="@+id/txt_signal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@color/teo_neutral"
                            android:gravity="center"
                            android:minHeight="28dp"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/home_absent"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Chip" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_activity"
                            style="@style/Widget.Teo.Home.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="@string/home_see_activity" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playtime_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/home_playtime"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Body" />

                        <TextView
                            android:id="@+id/txt_playtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/home_absent"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/playtime_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        android:max="1000"
                        app:indicatorColor="@color/teo_primary"
                        app:trackColor="@color/teo_outline"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/teo_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_now"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/now_playing_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/teo_ic_music"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/txt_now_playing"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/teo_primary" />

                    <TextView
                        android:id="@+id/txt_now_playing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/home_idle"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Body"
                        android:textColor="@color/teo_secondary"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/now_playing_icon"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/txt_music_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Secondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/playback_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_music_play"
                        style="@style/Widget.Teo.Home.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_play_music"
                        android:textColor="@color/teo_button_text"
                        app:backgroundTint="@color/teo_button_bg"
                        app:icon="@drawable/teo_ic_play"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/teo_button_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_music_stop"
                        style="@style/Widget.Teo.Home.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="104dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_stop"
                        android:textColor="@color/teo_stop_text"
                        app:backgroundTint="@color/teo_stop_bg"
                        app:icon="@drawable/teo_ic_stop"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/teo_stop_text" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_content"
                    style="@style/Widget.Teo.Home.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/home_see_content"
                    app:icon="@drawable/teo_ic_chevron"
                    app:iconGravity="textEnd"
                    app:iconPadding="2dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/teo_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_celebrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/teo_card_gap"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/teo_gold"
            app:cardCornerRadius="@dimen/teo_card_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/teo_gold"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/teo_celebration_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_celebrate"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Section"
                        android:textColor="@color/teo_on_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_celebrate_support"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Secondary"
                        android:textColor="@color/teo_on_gold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Teo.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/teo_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_recent_alerts"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Section" />

                <TextView
                    android:id="@+id/txt_alert_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_no_alerts"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Body" />

                <LinearLayout
                    android:id="@+id/alert_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_alert_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/teo_gold"
                        android:gravity="center"
                        android:minHeight="28dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Chip"
                        tools:text="Logro" />

                    <TextView
                        android:id="@+id/txt_alert_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Body"
                        tools:text="Ejemplo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_alert_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Teo.Home.Caption"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_all_alerts"
                        style="@style/Widget.Teo.Home.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_see_alerts" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txt_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/home_waiting"
            android:textAppearance="@style/TextAppearance.Teo.Home.Secondary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
