<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/img_wifi"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/teo_ic_wifi" />

    <TextView
        android:id="@+id/txt_network_ssid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Teo.Home.Body"
        android:textColor="@color/teo_text"
        android:textStyle="bold"
        tools:text="Casa" />

    <ImageView
        android:id="@+id/img_lock"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/wifi_setup_secure"
        android:src="@drawable/teo_ic_lock"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txt_network_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/wifi_setup_open_short"
        android:textAppearance="@style/TextAppearance.Teo.Home.Caption"
        android:visibility="gone" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <RadioButton
        android:id="@+id/radio_network"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/teo_checkbox"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />
</LinearLayout>
