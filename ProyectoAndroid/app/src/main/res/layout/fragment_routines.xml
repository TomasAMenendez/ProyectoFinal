<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/routines_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teo_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/teo_screen_margin"
    android:paddingEnd="@dimen/teo_screen_margin"
    tools:context=".ui.routines.RoutinesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <LinearLayout
            android:id="@+id/header_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/header_actions"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/home_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/teo_logo" />

            <TextView
                android:id="@+id/txt_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/routines_title"
                android:textAppearance="@style/TextAppearance.Teo.Home.Title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btn_alerts_bell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="@dimen/teo_icon_size"
                    android:layout_height="@dimen/teo_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/teo_ic_bell"
                    app:tint="@color/teo_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_alerts"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Chip" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_my_teo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="@dimen/teo_icon_size"
                    android:layout_height="@dimen/teo_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/teo_ic_gear"
                    app:tint="@color/teo_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_my_teo"
                    android:textAppearance="@style/TextAppearance.Teo.Home.Chip" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/routines_subtitle"
        android:textAppearance="@style/TextAppearance.Teo.Home.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add"
        style="@style/Widget.Teo.Home.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/routines_add"
        app:icon="@drawable/teo_ic_add"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="18dp"
        app:iconTint="@color/white" />

    <TextView
        android:id="@+id/txt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/routines_empty"
        android:textAppearance="@style/TextAppearance.Teo.Secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_routines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_routine" />
</LinearLayout>
