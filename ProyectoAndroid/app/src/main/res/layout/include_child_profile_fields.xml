<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView style="@style/Widget.Teo.Home.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_section_child" android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:labelFor="@id/edit_child_name"
                android:text="@string/profile_name_label" android:textAppearance="@style/TextAppearance.Teo.Home.Body" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_child_name"
                style="@style/Widget.Teo.Profile.Field" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                app:counterEnabled="true" app:counterMaxLength="40">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_child_name"
                    style="@style/Widget.Teo.Profile.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/profile_name_placeholder"
                    android:inputType="textPersonName|textCapWords" android:maxLength="40" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/toggle_gender"
                android:text="@string/profile_gender_label" android:textAppearance="@style/TextAppearance.Teo.Home.Body" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/toggle_gender"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="0dp" app:singleSelection="true" app:selectionRequired="false">
                <com.google.android.material.chip.Chip android:id="@+id/btn_gender_nene" style="@style/Widget.Teo.Profile.Gender"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/child_profile_gender_nene" />
                <com.google.android.material.chip.Chip android:id="@+id/btn_gender_nena" style="@style/Widget.Teo.Profile.Gender"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/child_profile_gender_nena" />
                <com.google.android.material.chip.Chip android:id="@+id/btn_gender_no_decir" style="@style/Widget.Teo.Profile.Gender"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/child_profile_gender_no_decir" />
            </com.google.android.material.chip.ChipGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/edit_child_interests"
                android:text="@string/profile_interests_label" android:textAppearance="@style/TextAppearance.Teo.Home.Body" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_child_interests"
                style="@style/Widget.Teo.Profile.Field" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" app:counterEnabled="true" app:counterMaxLength="600">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_child_interests"
                    style="@style/Widget.Teo.Profile.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/profile_interests_placeholder" android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences" android:maxLength="600" android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/edit_child_extra"
                android:text="@string/profile_extra_label" android:textAppearance="@style/TextAppearance.Teo.Home.Body" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_child_extra"
                style="@style/Widget.Teo.Profile.Field" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" app:counterEnabled="true" app:counterMaxLength="600">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_child_extra"
                    style="@style/Widget.Teo.Profile.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/profile_extra_placeholder" android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences" android:maxLength="600" android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.Teo.Home.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_section_teo" android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/profile_costume" android:textAppearance="@style/TextAppearance.Teo.Home.Body" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/btn_costume"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/teo_background"
                app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/teo_outline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp"
                    android:importantForAccessibility="noHideDescendants">
                    <ImageView android:id="@+id/img_costume" android:layout_width="72dp" android:layout_height="96dp"
                        android:contentDescription="@null" android:scaleType="matrix" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/txt_costume" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Teo.Home.Section" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:text="@string/profile_change_costume" android:textAppearance="@style/TextAppearance.Teo.Home.Secondary" />
                    </LinearLayout>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
                        android:src="@drawable/teo_ic_chevron" app:tint="@color/teo_primary" android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/profile_costume_applies" android:textAppearance="@style/TextAppearance.Teo.Home.Caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/Widget.Teo.Home.Button"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:enabled="false" android:text="@string/profile_save_changes"
        android:textColor="@color/teo_button_text" app:backgroundTint="@color/teo_button_bg" />
</LinearLayout>
