<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Teo.Home.Base" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/teo_text</item>
    </style>

    <style name="TextAppearance.Teo.Home.Title" parent="TextAppearance.Teo.Home.Base">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Teo.Home.Name" parent="TextAppearance.Teo.Home.Base">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Teo.Home.Section" parent="TextAppearance.Teo.Home.Base">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Teo.Home.Body" parent="TextAppearance.Teo.Home.Base">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Teo.Home.Secondary" parent="TextAppearance.Teo.Home.Base">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/teo_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Teo.Home.Metric" parent="TextAppearance.Teo.Home.Base">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:textColor">@color/teo_on_cyan</item>
    </style>

    <style name="TextAppearance.Teo.Home.Chip" parent="TextAppearance.Teo.Home.Base">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Teo.Home.Caption" parent="TextAppearance.Teo.Home.Base">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/teo_secondary</item>
    </style>

    <style name="TextAppearance.Teo.Routine.Time" parent="TextAppearance.Teo.Home.Base">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teo_text</item>
    </style>

    <style name="TextAppearance.Teo.Routine.Name" parent="TextAppearance.Teo.Home.Base">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/teo_text</item>
    </style>

    <style name="TextAppearance.Teo.Routine.Message" parent="TextAppearance.Teo.Home.Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Teo.Home.Card" parent="Widget.Teo.Card">
        <item name="contentPadding">12dp</item>
        <item name="contentPaddingBottom">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Teo.Home.Button" parent="Widget.Teo.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Teo.Home.Meta" parent="Widget.Teo.Button.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/teo_secondary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/teo_secondary</item>
    </style>

    <style name="Widget.Teo.Home.Quiet" parent="Widget.Teo.Button.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Teo.Period" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@color/teo_choice_bg</item>
        <item name="android:textColor">@color/teo_choice_text</item>
        <item name="strokeColor">@color/teo_outline</item>
        <item name="rippleColor">@color/teo_cyan</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Teo.Home.Link" parent="Widget.Teo.Button.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="icon">@drawable/teo_ic_chevron</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/teo_primary</item>
    </style>
</resources>
