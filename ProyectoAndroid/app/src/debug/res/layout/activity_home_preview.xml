<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teo_background"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/txt_example_banner"
        style="@style/Widget.Teo.Home.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/preview_example_banner"
        android:textAppearance="@style/TextAppearance.Teo.Home.Chip"
        android:textSize="12sp"
        android:textColor="@color/teo_on_gold"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/teo_gold"
        app:iconGravity="textEnd"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/teo_on_gold" />

    <FrameLayout
        android:id="@+id/preview_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/preview_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />
</LinearLayout>
